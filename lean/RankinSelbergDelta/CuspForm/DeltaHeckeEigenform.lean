import Mathlib
import RankinSelbergDelta.CuspForm.Discriminant
import RankinSelbergDelta.CuspForm.HeckeOperator
import RankinSelbergDelta.RankinSelberg.HeckeMultiplicativity

/-!
# The modular discriminant is a Hecke eigenform

`Δ` is a nonzero multiple of `η²⁴` on the upper half-plane, every level-one cusp form of weight
12 is a multiple of `η²⁴` (`exists_eq_mul_η24`), and the Hecke operator `T_p` maps level-one cusp
forms to cusp forms with the coefficient formula `b(n) = a(pn) + [p ∣ n] p^{k−1} a(n/p)`.
Hence `T_p Δ = c_p Δ` for every prime `p` (`heckeT_Delta_eq_smul`), and the normalised
coefficients satisfy the Hecke relations.
-/

open ModularForm EisensteinSeries CongruenceSubgroup UpperHalfPlane Complex Filter Topology
open scoped ModularForm Real


/-! ### `SL(2, ℤ)` is generated by `S` and `T`, and slash-invariance under `S` and `T`
implies slash-invariance under all of `SL(2, ℤ)` -/

namespace RankinSelbergDelta.Hecke

open Matrix ModularGroup UpperHalfPlane
open scoped ModularForm MatrixGroups

/-- The entries of `γ * T ^ n`: the bottom row is `(c, c n + d)`. -/
lemma mul_T_zpow_one_zero (γ : SL(2, ℤ)) (n : ℤ) : (γ * T ^ n) 1 0 = γ 1 0 := by
  simp [Matrix.SpecialLinearGroup.coe_mul, coe_T_zpow, Matrix.mul_apply, Fin.sum_univ_two]

lemma mul_T_zpow_one_one (γ : SL(2, ℤ)) (n : ℤ) : (γ * T ^ n) 1 1 = γ 1 0 * n + γ 1 1 := by
  simp [Matrix.SpecialLinearGroup.coe_mul, coe_T_zpow, Matrix.mul_apply, Fin.sum_univ_two]

/-- The bottom-left entry of `γ * S` is the bottom-right entry of `γ`. -/
lemma mul_S_one_zero (γ : SL(2, ℤ)) : (γ * S) 1 0 = γ 1 1 := by
  simp [Matrix.SpecialLinearGroup.coe_mul, coe_S, Matrix.mul_apply, Fin.sum_univ_two]

/-- An element with `c = 0` is `T ^ b` or `S * S * T ^ (-b)`. -/
lemma eq_T_zpow_or_of_one_zero_eq_zero (γ : SL(2, ℤ)) (hc : γ 1 0 = 0) :
    γ = T ^ (γ 0 1) ∨ γ = S * S * T ^ (-(γ 0 1)) := by
  have hdet : γ 0 0 * γ 1 1 - γ 0 1 * γ 1 0 = 1 := by
    have := γ.2
    rwa [Matrix.det_fin_two] at this
  rw [hc, mul_zero, sub_zero] at hdet
  rcases Int.eq_one_or_neg_one_of_mul_eq_one' hdet with ⟨ha, hd⟩ | ⟨ha, hd⟩
  · left
    ext i j
    fin_cases i <;> fin_cases j <;> simp [coe_T_zpow, ha, hd, hc]
  · right
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.SpecialLinearGroup.coe_mul, coe_T_zpow, coe_S, Matrix.mul_apply,
        Fin.sum_univ_two, ha, hd, hc]

lemma S_mem_closure : S ∈ Subgroup.closure ({S, T} : Set SL(2, ℤ)) :=
  Subgroup.subset_closure (by simp)

lemma T_mem_closure : T ∈ Subgroup.closure ({S, T} : Set SL(2, ℤ)) :=
  Subgroup.subset_closure (by simp)

/-- **`SL(2, ℤ)` is generated by `S` and `T`**, by Euclid's algorithm on the bottom row. -/
theorem mem_closure_S_T (γ : SL(2, ℤ)) : γ ∈ Subgroup.closure ({S, T} : Set SL(2, ℤ)) := by
  suffices h : ∀ n : ℕ, ∀ γ : SL(2, ℤ), (γ 1 0).natAbs ≤ n →
      γ ∈ Subgroup.closure ({S, T} : Set SL(2, ℤ)) from h _ γ le_rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro γ hγ
    by_cases hc : γ 1 0 = 0
    · rcases eq_T_zpow_or_of_one_zero_eq_zero γ hc with h | h
      · rw [h]; exact Subgroup.zpow_mem _ T_mem_closure _
      · rw [h]
        exact Subgroup.mul_mem _ (Subgroup.mul_mem _ S_mem_closure S_mem_closure)
          (Subgroup.zpow_mem _ T_mem_closure _)
    · set c := γ 1 0 with hc_def
      set d := γ 1 1 with hd_def
      set q := d / c with hq
      set r := d % c with hr
      have hrd : r = d - c * q := by
        rw [hr, hq]
        have := Int.emod_add_ediv d c
        linarith
      have hr0 : 0 ≤ r := Int.emod_nonneg d hc
      have hrlt : r < (c.natAbs : ℤ) := Int.emod_lt d hc
      have hrabs : r.natAbs < c.natAbs := by
        have h1 : (r.natAbs : ℤ) = r := Int.natAbs_of_nonneg hr0
        have : (r.natAbs : ℤ) < c.natAbs := by rw [h1]; exact hrlt
        exact_mod_cast this
      set γ' := γ * T ^ (-q) * S with hγ'
      have h10 : γ' 1 0 = r := by
        rw [hγ', mul_S_one_zero, mul_T_zpow_one_one, hrd]
        ring
      have hmem : γ' ∈ Subgroup.closure ({S, T} : Set SL(2, ℤ)) :=
        ih r.natAbs (lt_of_lt_of_le hrabs hγ) γ' (by rw [h10])
      have hγeq : γ = γ' * S⁻¹ * T ^ q := by
        rw [hγ']
        group
      rw [hγeq]
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hmem (Subgroup.inv_mem _ S_mem_closure))
        (Subgroup.zpow_mem _ T_mem_closure _)

/-- Slash-invariance under `S` and `T` gives slash-invariance under every `γ ∈ SL(2, ℤ)`. -/
theorem slash_eq_of_S_T {k : ℤ} {f : ℍ → ℂ} (hS : f ∣[k] S = f) (hT : f ∣[k] T = f)
    (γ : SL(2, ℤ)) : f ∣[k] γ = f := by
  have hγ := mem_closure_S_T γ
  induction hγ using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact hS
    · exact hT
  | one => exact SlashAction.slash_one k f
  | mul x y _ _ hx hy => rw [SlashAction.slash_mul, hx, hy]
  | inv x _ hx =>
    calc f ∣[k] x⁻¹ = (f ∣[k] x) ∣[k] x⁻¹ := by rw [hx]
      _ = f ∣[k] (x * x⁻¹) := (SlashAction.slash_mul k x x⁻¹ f).symm
      _ = f := by rw [mul_inv_cancel, SlashAction.slash_one]

end RankinSelbergDelta.Hecke

/-! ### the coset identities, invariance of `heckeT` under `T` and `S`, and the
cusp-form packaging `heckeTCuspForm` -/

namespace RankinSelbergDelta.Hecke

open Matrix Complex UpperHalfPlane CongruenceSubgroup ModularGroup ModularForm
open scoped ModularForm MatrixGroups Manifold

/-- The matrix entries of an `SL(2, ℤ)` element viewed in `GL(2, ℝ)`. -/
lemma coe_SL_GL_apply (γ : SL(2, ℤ)) (i j : Fin 2) :
    ((γ : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) i j = ((γ i j : ℤ) : ℝ) := by
  simp [Matrix.SpecialLinearGroup.mapGL_coe_matrix, Matrix.map_apply]

lemma coe_T_zpow_GL (n : ℤ) :
    (((T ^ n : SL(2, ℤ)) : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = !![1, (n : ℝ); 0, 1] := by
  ext i k
  rw [coe_SL_GL_apply, coe_T_zpow]
  fin_cases i <;> fin_cases k <;> simp

lemma coe_T_GL : (((T : SL(2, ℤ)) : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = !![1, 1; 0, 1] := by
  ext i k
  rw [coe_SL_GL_apply, coe_T]
  fin_cases i <;> fin_cases k <;> simp

lemma coe_S_GL : (((S : SL(2, ℤ)) : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = !![0, -1; 1, 0] := by
  ext i k
  rw [coe_SL_GL_apply, coe_S]
  fin_cases i <;> fin_cases k <;> simp

/-! #### The `T`-identities -/

lemma heckeCoset_mul_T (p j : ℕ) (hp : (p : ℝ) ≠ 0) :
    heckeCoset p j hp * (T : GL (Fin 2) ℝ) = heckeCoset p (j + 1) hp := by
  apply Units.ext
  rw [Units.val_mul]
  simp only [heckeCoset, mkGL_coe, coe_T_GL]
  ext i k
  fin_cases i <;> fin_cases k <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two] <;> ring

lemma heckeCoset_p_eq (p : ℕ) (hp : (p : ℝ) ≠ 0) :
    heckeCoset p p hp = (T : GL (Fin 2) ℝ) * heckeCoset p 0 hp := by
  apply Units.ext
  rw [Units.val_mul]
  simp only [heckeCoset, mkGL_coe, coe_T_GL]
  ext i k
  fin_cases i <;> fin_cases k <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two] <;> ring

lemma heckeCosetInf_mul_T (p : ℕ) (hp : (p : ℝ) ≠ 0) :
    heckeCosetInf p hp * (T : GL (Fin 2) ℝ)
      = ((T ^ (p : ℤ) : SL(2, ℤ)) : GL (Fin 2) ℝ) * heckeCosetInf p hp := by
  apply Units.ext
  rw [Units.val_mul, Units.val_mul]
  simp only [heckeCosetInf, mkGL_coe, coe_T_GL, coe_T_zpow_GL]
  ext i k
  fin_cases i <;> fin_cases k <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two] <;> ring

/-! #### The `S`-identities -/

lemma heckeCoset_zero_mul_S (p : ℕ) (hp : (p : ℝ) ≠ 0) :
    heckeCoset p 0 hp * (S : GL (Fin 2) ℝ) = (S : GL (Fin 2) ℝ) * heckeCosetInf p hp := by
  apply Units.ext
  rw [Units.val_mul, Units.val_mul]
  simp only [heckeCoset, heckeCosetInf, mkGL_coe, coe_S_GL]
  ext i k
  fin_cases i <;> fin_cases k <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two] <;> ring

lemma heckeCosetInf_mul_S (p : ℕ) (hp : (p : ℝ) ≠ 0) :
    heckeCosetInf p hp * (S : GL (Fin 2) ℝ) = (S : GL (Fin 2) ℝ) * heckeCoset p 0 hp := by
  apply Units.ext
  rw [Units.val_mul, Units.val_mul]
  simp only [heckeCoset, heckeCosetInf, mkGL_coe, coe_S_GL]
  ext i k
  fin_cases i <;> fin_cases k <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two] <;> ring

/-- `σ(j) = (−j⁻¹ mod p)` for `0 < j < p`: the `S`-permutation of the coset representatives. -/
def heckeInv (p j : ℕ) : ℕ := (-((j : ZMod p)⁻¹)).val

lemma heckeInv_lt (p : ℕ) [NeZero p] (j : ℕ) : heckeInv p j < p := ZMod.val_lt _

lemma natCast_ne_zero_of_lt (p : ℕ) {j : ℕ} (hj0 : 0 < j) (hjp : j < p) : (j : ZMod p) ≠ 0 := by
  rw [Ne, ZMod.natCast_eq_zero_iff]
  exact fun h => absurd (Nat.le_of_dvd hj0 h) (not_le.mpr hjp)

lemma heckeInv_spec (p : ℕ) (hp : p.Prime) {j : ℕ} (hj0 : 0 < j) (hjp : j < p) :
    p ∣ j * heckeInv p j + 1 := by
  haveI := Fact.mk hp
  rw [← ZMod.natCast_eq_zero_iff]
  push_cast
  rw [heckeInv, ZMod.natCast_zmod_val, mul_neg, mul_inv_cancel₀ (natCast_ne_zero_of_lt p hj0 hjp),
    neg_add_cancel]

lemma heckeInv_pos (p : ℕ) (hp : p.Prime) {j : ℕ} (hj0 : 0 < j) (hjp : j < p) :
    0 < heckeInv p j := by
  haveI := Fact.mk hp
  rw [Nat.pos_iff_ne_zero, heckeInv, Ne, ZMod.val_eq_zero, neg_eq_zero, inv_eq_zero]
  exact natCast_ne_zero_of_lt p hj0 hjp

lemma heckeInv_heckeInv (p : ℕ) (hp : p.Prime) {j : ℕ} (hj0 : 0 < j) (hjp : j < p) :
    heckeInv p (heckeInv p j) = j := by
  haveI := Fact.mk hp
  rw [heckeInv, heckeInv, ZMod.natCast_zmod_val, inv_neg, inv_inv, neg_neg,
    ZMod.val_cast_of_lt hjp]

/-- The integer `(jσ(j) + 1)/p`. -/
def heckeQ (p j : ℕ) : ℕ := (j * heckeInv p j + 1) / p

lemma heckeQ_spec (p : ℕ) (hp : p.Prime) {j : ℕ} (hj0 : 0 < j) (hjp : j < p) :
    p * heckeQ p j = j * heckeInv p j + 1 :=
  Nat.mul_div_cancel' (heckeInv_spec p hp hj0 hjp)

/-- The `SL(2, ℤ)` matrix `[[j, −(jσ(j)+1)/p], [p, −σ(j)]]` with
`[[1, j], [0, p]] · S = γ_j · [[1, σ(j)], [0, p]]`. -/
def heckeGamma (p : ℕ) (hp : p.Prime) {j : ℕ} (hj0 : 0 < j) (hjp : j < p) : SL(2, ℤ) :=
  ⟨!![(j : ℤ), -((heckeQ p j : ℕ) : ℤ); (p : ℤ), -((heckeInv p j : ℕ) : ℤ)], by
    rw [Matrix.det_fin_two_of]
    have hq : (p : ℤ) * (heckeQ p j : ℤ) = (j : ℤ) * (heckeInv p j : ℤ) + 1 := by
      exact_mod_cast heckeQ_spec p hp hj0 hjp
    linear_combination hq⟩

lemma heckeGamma_GL (p : ℕ) (hp : p.Prime) {j : ℕ} (hj0 : 0 < j) (hjp : j < p) :
    (((heckeGamma p hp hj0 hjp : SL(2, ℤ)) : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ)
      = !![(j : ℝ), -(heckeQ p j : ℝ); (p : ℝ), -(heckeInv p j : ℝ)] := by
  ext i k
  rw [coe_SL_GL_apply]
  show (((!![(j : ℤ), -((heckeQ p j : ℕ) : ℤ); (p : ℤ), -((heckeInv p j : ℕ) : ℤ)]
    : Matrix (Fin 2) (Fin 2) ℤ) i k : ℤ) : ℝ) = _
  fin_cases i <;> fin_cases k <;> simp

lemma heckeCoset_mul_S (p : ℕ) (hp : p.Prime) (hp' : (p : ℝ) ≠ 0) {j : ℕ} (hj0 : 0 < j)
    (hjp : j < p) :
    heckeCoset p j hp' * (S : GL (Fin 2) ℝ)
      = (heckeGamma p hp hj0 hjp : GL (Fin 2) ℝ) * heckeCoset p (heckeInv p j) hp' := by
  apply Units.ext
  rw [Units.val_mul, Units.val_mul]
  simp only [heckeCoset, mkGL_coe, coe_S_GL, heckeGamma_GL]
  have hq : (p : ℝ) * (heckeQ p j : ℝ) = (j : ℝ) * (heckeInv p j : ℝ) + 1 := by
    exact_mod_cast heckeQ_spec p hp hj0 hjp
  ext i k
  fin_cases i <;> fin_cases k <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two] <;>
    first | ring1 | linear_combination hq | linear_combination -hq

/-! #### Invariance of `heckeT` -/

variable {p : ℕ} {k : ℤ} {f : ℍ → ℂ}

/-- The slash of `heckeT` by `γ ∈ SL(2, ℤ)`, pointwise. -/
lemma heckeT_slash_apply (hp : (p : ℝ) ≠ 0) (γ : SL(2, ℤ)) (τ : ℍ) :
    (heckeT p k hp f ∣[k] γ) τ
      = (∑ j ∈ Finset.range p, (f ∣[k] (heckeCoset p j hp * (γ : GL (Fin 2) ℝ))) τ)
        + (f ∣[k] (heckeCosetInf p hp * (γ : GL (Fin 2) ℝ))) τ := by
  rw [SL_slash_apply]
  simp only [heckeT, Finset.sum_mul, add_mul]
  congr 1
  · exact Finset.sum_congr rfl fun j _ => by rw [SlashAction.slash_mul, ← SL_slash, SL_slash_apply]
  · rw [SlashAction.slash_mul, ← SL_slash, SL_slash_apply]

/-- `heckeT f` is invariant under `T` when `f` is `SL(2, ℤ)`-invariant. -/
theorem heckeT_slash_T (hp : (p : ℝ) ≠ 0) (hf : ∀ γ : SL(2, ℤ), f ∣[k] γ = f) :
    heckeT p k hp f ∣[k] T = heckeT p k hp f := by
  funext τ
  rw [heckeT_slash_apply hp T τ]
  have h1 : ∀ j, f ∣[k] (heckeCoset p j hp * (T : GL (Fin 2) ℝ)) = f ∣[k] heckeCoset p (j + 1) hp :=
    fun j => by rw [heckeCoset_mul_T]
  have h2 : f ∣[k] (heckeCosetInf p hp * (T : GL (Fin 2) ℝ)) = f ∣[k] heckeCosetInf p hp := by
    rw [heckeCosetInf_mul_T, SlashAction.slash_mul, ← SL_slash, hf]
  have h3 : f ∣[k] heckeCoset p p hp = f ∣[k] heckeCoset p 0 hp := by
    rw [heckeCoset_p_eq, SlashAction.slash_mul, ← SL_slash, hf]
  simp only [h1, h2, heckeT]
  congr 1
  set F : ℕ → ℂ := fun j => (f ∣[k] heckeCoset p j hp) τ with hF
  have e1 := Finset.sum_range_succ' F p
  have e2 := Finset.sum_range_succ F p
  have e3 : F p = F 0 := congrFun h3 τ
  show ∑ j ∈ Finset.range p, F (j + 1) = ∑ j ∈ Finset.range p, F j
  linear_combination -e1 + e2 + e3

/-- `heckeT f` is invariant under `S` when `f` is `SL(2, ℤ)`-invariant (`p` prime). -/
theorem heckeT_slash_S (hpp : p.Prime) (hp : (p : ℝ) ≠ 0) (hf : ∀ γ : SL(2, ℤ), f ∣[k] γ = f) :
    heckeT p k hp f ∣[k] S = heckeT p k hp f := by
  haveI : NeZero p := ⟨hpp.ne_zero⟩
  funext τ
  rw [heckeT_slash_apply hp S τ]
  simp only [heckeT]
  set F : ℕ → ℂ := fun j => (f ∣[k] heckeCoset p j hp) τ with hF
  set G : ℕ → ℂ := fun j => (f ∣[k] (heckeCoset p j hp * (S : GL (Fin 2) ℝ))) τ with hG
  have h0mem : 0 ∈ Finset.range p := Finset.mem_range.mpr hpp.pos
  have hG0 : G 0 = (f ∣[k] heckeCosetInf p hp) τ := by
    simp only [hG]
    rw [heckeCoset_zero_mul_S, SlashAction.slash_mul, ← SL_slash, hf]
  have hInf : (f ∣[k] (heckeCosetInf p hp * (S : GL (Fin 2) ℝ))) τ = F 0 := by
    simp only [hF]
    rw [heckeCosetInf_mul_S, SlashAction.slash_mul, ← SL_slash, hf]
  have hGj : ∀ j ∈ Finset.range p \ {0}, G j = F (heckeInv p j) := by
    intro j hj
    rw [Finset.mem_sdiff, Finset.mem_range, Finset.mem_singleton] at hj
    have hj0 : 0 < j := Nat.pos_of_ne_zero hj.2
    simp only [hG, hF]
    rw [heckeCoset_mul_S p hpp hp hj0 hj.1, SlashAction.slash_mul, ← SL_slash, hf]
  have hsplit : ∀ H : ℕ → ℂ, ∑ j ∈ Finset.range p, H j = H 0 + ∑ j ∈ Finset.range p \ {0}, H j :=
    fun H => Finset.sum_eq_add_sum_diff_singleton h0mem H
  have hperm : ∑ j ∈ Finset.range p \ {0}, F (heckeInv p j) = ∑ j ∈ Finset.range p \ {0}, F j := by
    refine Finset.sum_nbij' (heckeInv p) (heckeInv p) ?_ ?_ ?_ ?_ ?_
    · intro j hj
      rw [Finset.mem_sdiff, Finset.mem_range, Finset.mem_singleton] at hj ⊢
      exact ⟨heckeInv_lt p j, (heckeInv_pos p hpp (Nat.pos_of_ne_zero hj.2) hj.1).ne'⟩
    · intro j hj
      rw [Finset.mem_sdiff, Finset.mem_range, Finset.mem_singleton] at hj ⊢
      exact ⟨heckeInv_lt p j, (heckeInv_pos p hpp (Nat.pos_of_ne_zero hj.2) hj.1).ne'⟩
    · intro j hj
      rw [Finset.mem_sdiff, Finset.mem_range, Finset.mem_singleton] at hj
      exact heckeInv_heckeInv p hpp (Nat.pos_of_ne_zero hj.2) hj.1
    · intro j hj
      rw [Finset.mem_sdiff, Finset.mem_range, Finset.mem_singleton] at hj
      exact heckeInv_heckeInv p hpp (Nat.pos_of_ne_zero hj.2) hj.1
    · intro j _
      rfl
  show ∑ j ∈ Finset.range p, G j + (f ∣[k] (heckeCosetInf p hp * (S : GL (Fin 2) ℝ))) τ
    = ∑ j ∈ Finset.range p, F j + (f ∣[k] heckeCosetInf p hp) τ
  rw [hsplit G, hsplit F, Finset.sum_congr rfl hGj, hperm, hG0, hInf]
  ring

/-- **Invariance of `heckeT f` under all of `SL(2, ℤ)`.** -/
theorem heckeT_slash_invariant (hpp : p.Prime) (hp : (p : ℝ) ≠ 0)
    (hf : ∀ γ : SL(2, ℤ), f ∣[k] γ = f) (γ : SL(2, ℤ)) :
    heckeT p k hp f ∣[k] γ = heckeT p k hp f :=
  slash_eq_of_S_T (heckeT_slash_S hpp hp hf) (heckeT_slash_T hp hf) γ

/-! #### Holomorphy and the cusp -/

lemma heckeCoset_one_zero (p j : ℕ) (hp : (p : ℝ) ≠ 0) :
    ((heckeCoset p j hp : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) 1 0 = 0 := by
  simp [heckeCoset, mkGL_coe]

lemma heckeCosetInf_one_zero (p : ℕ) (hp : (p : ℝ) ≠ 0) :
    ((heckeCosetInf p hp : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) 1 0 = 0 := by
  simp [heckeCosetInf, mkGL_coe]

lemma isZeroAtImInfty_sum_range {G : ℕ → ℍ → ℂ} (hG : ∀ j, IsZeroAtImInfty (G j)) (n : ℕ) :
    IsZeroAtImInfty fun z => ∑ j ∈ Finset.range n, G j z := by
  induction n with
  | zero => simp only [Finset.range_zero, Finset.sum_empty]; exact Filter.zero_zeroAtFilter _
  | succ n ih =>
    simp only [Finset.sum_range_succ]
    exact ih.add (hG n)

theorem isZeroAtImInfty_heckeT (hp : (p : ℝ) ≠ 0) (hf : IsZeroAtImInfty f) :
    IsZeroAtImInfty (heckeT p k hp f) := by
  have h1 : IsZeroAtImInfty fun z => ∑ j ∈ Finset.range p, (f ∣[k] heckeCoset p j hp) z :=
    isZeroAtImInfty_sum_range (fun j => hf.slash k (heckeCoset_one_zero p j hp)) p
  have h2 : IsZeroAtImInfty (f ∣[k] heckeCosetInf p hp) := hf.slash k (heckeCosetInf_one_zero p hp)
  exact h1.add h2

theorem mdifferentiable_heckeT (hp : (p : ℝ) ≠ 0) (hf : MDifferentiable 𝓘(ℂ) 𝓘(ℂ) f) :
    MDifferentiable 𝓘(ℂ) 𝓘(ℂ) (heckeT p k hp f) := by
  have e : heckeT p k hp f
      = (∑ j ∈ Finset.range p, f ∣[k] heckeCoset p j hp) + f ∣[k] heckeCosetInf p hp := by
    funext z
    simp [heckeT, Finset.sum_apply]
  rw [e]
  exact (MDifferentiable.sum fun j _ => hf.slash k _).add (hf.slash k _)

variable {F : Type*} [FunLike F ℍ ℂ]

/-- A level-one form is slash-invariant under every `γ ∈ SL(2, ℤ)`. -/
lemma slash_SL_eq_self [SlashInvariantFormClass F (Γ(1) : Subgroup (GL (Fin 2) ℝ)) k] (g : F)
    (γ : SL(2, ℤ)) : (⇑g : ℍ → ℂ) ∣[k] γ = ⇑g := by
  rw [SL_slash]
  exact SlashInvariantForm.slash_action_eqn g _ (Subgroup.mem_map.mpr ⟨γ, mem_Gamma_one γ, rfl⟩)

/-- **`T_p f` is a level-one cusp form of weight `k`** for `p` prime and `f` a level-one cusp form. -/
noncomputable def heckeTCuspForm (p : ℕ) (hpp : p.Prime) (k : ℤ) (hp : (p : ℝ) ≠ 0)
    [CuspFormClass F (Γ(1) : Subgroup (GL (Fin 2) ℝ)) k] (g : F) :
    CuspForm (Γ(1) : Subgroup (GL (Fin 2) ℝ)) k where
  toFun := heckeT p k hp ⇑g
  slash_action_eq' := by
    intro γ hγ
    obtain ⟨γ', _, rfl⟩ := Subgroup.mem_map.mp hγ
    exact heckeT_slash_invariant hpp hp (slash_SL_eq_self g) γ'
  holo' := mdifferentiable_heckeT hp (CuspFormClass.holo g)
  zero_at_cusps' := by
    intro c hc
    rw [Subgroup.IsArithmetic.isCusp_iff_isCusp_SL2Z] at hc
    rw [OnePoint.isZeroAt_iff_forall_SL2Z hc]
    intro γ _
    rw [heckeT_slash_invariant hpp hp (slash_SL_eq_self g) γ]
    exact isZeroAtImInfty_heckeT hp (CuspFormClass.zero_at_infty g)

lemma coe_heckeTCuspForm (p : ℕ) (hpp : p.Prime) (k : ℤ) (hp : (p : ℝ) ≠ 0)
    [CuspFormClass F (Γ(1) : Subgroup (GL (Fin 2) ℝ)) k] (g : F) :
    (⇑(heckeTCuspForm p hpp k hp g) : ℍ → ℂ) = heckeT p k hp ⇑g := rfl

end RankinSelbergDelta.Hecke

/-! ### `η²⁴` is a weight-12 level-one form, every weight-12 level-one cusp form is a
multiple of it, hence `Δ ≠ 0` on `ℍ` and `T_p Δ = c_p Δ` -/

namespace RankinSelbergDelta.Hecke

open Matrix Complex UpperHalfPlane CongruenceSubgroup ModularGroup ModularForm Filter Topology
open scoped ModularForm MatrixGroups Manifold Real

local notation "𝕢" => Function.Periodic.qParam
local notation "ℍₒ" => upperHalfPlaneSet

/-! #### `η` under `z ↦ z + 1` -/

lemma qParam_add_one (h : ℝ) (z : ℂ) :
    𝕢 h (z + 1) = 𝕢 h z * cexp (2 * π * Complex.I / h) := by
  simp only [Function.Periodic.qParam]
  rw [← Complex.exp_add]
  congr 1
  ring

lemma eta_q_add_one (n : ℕ) (z : ℂ) : eta_q n (z + 1) = eta_q n z := by
  simp only [eta_q]
  rw [qParam_add_one]
  push_cast
  rw [div_one, Complex.exp_two_pi_mul_I, mul_one]

lemma eta_add_one (z : ℂ) :
    ModularForm.eta (z + 1) = cexp (2 * π * Complex.I / 24) * ModularForm.eta z := by
  unfold ModularForm.eta
  simp only [eta_q_add_one]
  rw [qParam_add_one]
  push_cast
  ring

lemma eta_add_one_pow (z : ℂ) : ModularForm.eta (z + 1) ^ 24 = ModularForm.eta z ^ 24 := by
  rw [eta_add_one, mul_pow, ← Complex.exp_nat_mul]
  have : ((24 : ℕ) : ℂ) * (2 * π * Complex.I / 24) = 2 * π * Complex.I := by push_cast; ring
  rw [this, Complex.exp_two_pi_mul_I, one_mul]

/-! #### `η` under `z ↦ −1/z`: the log-derivative argument -/

lemma ne_zero_of_mem_upperHalfPlaneSet {w : ℂ} (hw : w ∈ ℍₒ) : w ≠ 0 := by
  intro h
  have h' : 0 < w.im := hw
  rw [h] at h'
  simp at h'

lemma neg_inv_mem_upperHalfPlaneSet {w : ℂ} (hw : w ∈ ℍₒ) : -w⁻¹ ∈ ℍₒ := by
  show 0 < (-w⁻¹).im
  have h := (⟨w, hw⟩ : ℍ).im_inv_neg_coe_pos
  rwa [inv_neg] at h

lemma hasDerivAt_neg_inv {w : ℂ} (hw0 : w ≠ 0) :
    HasDerivAt (fun w : ℂ => -w⁻¹) ((w ^ 2)⁻¹) w := by
  have h := (hasDerivAt_inv hw0).neg
  rwa [neg_neg] at h

lemma differentiableAt_eta_neg_inv {w : ℂ} (hw : w ∈ ℍₒ) :
    DifferentiableAt ℂ (fun w : ℂ => ModularForm.eta (-w⁻¹)) w := by
  show DifferentiableAt ℂ (ModularForm.eta ∘ fun w : ℂ => -w⁻¹) w
  exact DifferentiableAt.comp w
    (differentiableAt_eta_of_mem_upperHalfPlaneSet (neg_inv_mem_upperHalfPlaneSet hw))
    (hasDerivAt_neg_inv (ne_zero_of_mem_upperHalfPlaneSet hw)).differentiableAt

/-- The function `U(w) = η(−1/w)²⁴ / (w¹² η(w)²⁴)`. -/
noncomputable def etaU (w : ℂ) : ℂ :=
  ModularForm.eta (-w⁻¹) ^ 24 / (w ^ 12 * ModularForm.eta w ^ 24)

lemma etaU_denom_ne_zero {w : ℂ} (hw : w ∈ ℍₒ) : w ^ 12 * ModularForm.eta w ^ 24 ≠ 0 :=
  mul_ne_zero (pow_ne_zero _ (ne_zero_of_mem_upperHalfPlaneSet hw)) (pow_ne_zero _ (eta_ne_zero hw))

lemma differentiableAt_etaU {w : ℂ} (hw : w ∈ ℍₒ) : DifferentiableAt ℂ etaU w := by
  have hA : DifferentiableAt ℂ (fun w : ℂ => ModularForm.eta (-w⁻¹) ^ 24) w :=
    (differentiableAt_eta_neg_inv hw).pow 24
  have hB : DifferentiableAt ℂ (fun w : ℂ => w ^ 12) w := differentiableAt_id.pow 12
  have hC : DifferentiableAt ℂ (fun w : ℂ => ModularForm.eta w ^ 24) w :=
    (differentiableAt_eta_of_mem_upperHalfPlaneSet hw).pow 24
  exact hA.div (hB.mul hC) (etaU_denom_ne_zero hw)

/-- The `E2` transformation law under `S`, solved for `E2 (S • z)`:
`E2(−1/z) = z² E2(z) − (6i/π) z`. -/
lemma E2_S_eq (z : ℍ) :
    EisensteinSeries.E2 (S • z)
      = (z : ℂ) ^ 2 * EisensteinSeries.E2 z - (6 * Complex.I / π) * z := by
  have h := congrFun (EisensteinSeries.E2_slash_action S) z
  rw [SL_slash_apply, denom_S, Pi.sub_apply, Pi.smul_apply, EisensteinSeries.D2_S,
    riemannZeta_two, smul_eq_mul] at h
  have hz : (z : ℂ) ≠ 0 := z.ne_zero
  have hπ : (π : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  rw [_root_.zpow_neg, zpow_ofNat] at h
  have h' : EisensteinSeries.E2 (S • z)
      = (EisensteinSeries.E2 z - 1 / (2 * ((π : ℂ) ^ 2 / 6)) * (2 * π * Complex.I / z))
        * (z : ℂ) ^ 2 := by
    rw [← h]
    field_simp
  rw [h']
  field_simp
  try ring

lemma logDeriv_etaU_eq_zero {w : ℂ} (hw : w ∈ ℍₒ) : logDeriv etaU w = 0 := by
  have hw0 := ne_zero_of_mem_upperHalfPlaneSet hw
  have hw' := neg_inv_mem_upperHalfPlaneSet hw
  have hgd := hasDerivAt_neg_inv hw0
  have hA' : DifferentiableAt ℂ (fun w : ℂ => ModularForm.eta (-w⁻¹)) w :=
    differentiableAt_eta_neg_inv hw
  have hAd : DifferentiableAt ℂ (fun w : ℂ => ModularForm.eta (-w⁻¹) ^ 24) w := hA'.pow 24
  have hBd : DifferentiableAt ℂ (fun w : ℂ => w ^ 12) w := differentiableAt_id.pow 12
  have hCd : DifferentiableAt ℂ (fun w : ℂ => ModularForm.eta w ^ 24) w :=
    (differentiableAt_eta_of_mem_upperHalfPlaneSet hw).pow 24
  have hAne : ModularForm.eta (-w⁻¹) ^ 24 ≠ 0 := pow_ne_zero _ (eta_ne_zero hw')
  have hBne : w ^ 12 ≠ 0 := pow_ne_zero _ hw0
  have hCne : ModularForm.eta w ^ 24 ≠ 0 := pow_ne_zero _ (eta_ne_zero hw)
  have hηA : logDeriv (fun w : ℂ => ModularForm.eta (-w⁻¹) ^ 24) w
      = 24 * (logDeriv ModularForm.eta (-w⁻¹) * (w ^ 2)⁻¹) := by
    have h1 := logDeriv_fun_pow hA' 24
    have h2 : logDeriv (fun w : ℂ => ModularForm.eta (-w⁻¹)) w
        = logDeriv ModularForm.eta (-w⁻¹) * (w ^ 2)⁻¹ := by
      have := logDeriv_comp (f := ModularForm.eta) (g := fun w : ℂ => -w⁻¹) (x := w)
        (differentiableAt_eta_of_mem_upperHalfPlaneSet hw') hgd.differentiableAt
      rw [hgd.deriv] at this
      exact this
    rw [h1, h2]
    norm_num
  have hηC : logDeriv (fun w : ℂ => ModularForm.eta w ^ 24) w
      = 24 * logDeriv ModularForm.eta w := by
    rw [logDeriv_fun_pow (differentiableAt_eta_of_mem_upperHalfPlaneSet hw) 24]
    norm_num
  have hB : logDeriv (fun w : ℂ => w ^ 12) w = 12 / w := by
    have := logDeriv_pow w 12
    simpa using this
  have hU : logDeriv etaU w
      = logDeriv (fun w : ℂ => ModularForm.eta (-w⁻¹) ^ 24) w
        - (logDeriv (fun w : ℂ => w ^ 12) w + logDeriv (fun w : ℂ => ModularForm.eta w ^ 24) w) := by
    unfold etaU
    rw [logDeriv_div (f := fun w : ℂ => ModularForm.eta (-w⁻¹) ^ 24)
      (g := fun w : ℂ => w ^ 12 * ModularForm.eta w ^ 24) w hAne (mul_ne_zero hBne hCne) hAd
      (hBd.mul hCd),
      logDeriv_mul (f := fun w : ℂ => w ^ 12) (g := fun w : ℂ => ModularForm.eta w ^ 24) w hBne
      hCne hBd hCd]
  rw [hU, hηA, hηC, hB]
  have hSz : ((S • (⟨w, hw⟩ : ℍ) : ℍ) : ℂ) = -w⁻¹ := by
    rw [modular_S_smul]
    exact inv_neg
  have h1 : logDeriv ModularForm.eta (-w⁻¹)
      = (π * Complex.I / 12) * EisensteinSeries.E2 (S • (⟨w, hw⟩ : ℍ)) := by
    have := logDeriv_eta_eq_E2 (S • (⟨w, hw⟩ : ℍ))
    rwa [hSz] at this
  have h2 : logDeriv ModularForm.eta w = (π * Complex.I / 12) * EisensteinSeries.E2 (⟨w, hw⟩ : ℍ) :=
    logDeriv_eta_eq_E2 (⟨w, hw⟩ : ℍ)
  have hzw : ((⟨w, hw⟩ : ℍ) : ℂ) = w := rfl
  rw [h1, h2, E2_S_eq (⟨w, hw⟩ : ℍ), hzw]
  have hπ : (π : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  field_simp
  ring_nf
  try simp only [Complex.I_sq]
  try ring

lemma deriv_etaU_eq_zero {w : ℂ} (hw : w ∈ ℍₒ) : deriv etaU w = 0 := by
  have hne : etaU w ≠ 0 := by
    unfold etaU
    exact div_ne_zero (pow_ne_zero _ (eta_ne_zero (neg_inv_mem_upperHalfPlaneSet hw)))
      (etaU_denom_ne_zero hw)
  have := logDeriv_etaU_eq_zero hw
  rw [logDeriv_apply, div_eq_zero_iff] at this
  exact this.resolve_right hne

lemma etaU_I : etaU Complex.I = 1 := by
  unfold etaU
  rw [Complex.inv_I, neg_neg]
  have h12 : Complex.I ^ 12 = 1 := by
    rw [show (12 : ℕ) = 4 * 3 by norm_num, pow_mul, Complex.I_pow_four, one_pow]
  rw [h12, one_mul]
  exact div_self (pow_ne_zero _ (eta_ne_zero (by simp [upperHalfPlaneSet])))

/-- **`η(−1/w)²⁴ = w¹² η(w)²⁴`** on the upper half-plane. -/
theorem eta_S_pow {w : ℂ} (hw : w ∈ ℍₒ) :
    ModularForm.eta (-w⁻¹) ^ 24 = w ^ 12 * ModularForm.eta w ^ 24 := by
  have hconst : etaU w = etaU Complex.I :=
    isOpen_upperHalfPlaneSet.is_const_of_deriv_eq_zero (convex_halfSpace_im_gt 0).isPreconnected
      (fun v hv => (differentiableAt_etaU hv).differentiableWithinAt)
      (fun v hv => deriv_etaU_eq_zero hv) hw (by simp [upperHalfPlaneSet])
  rw [etaU_I] at hconst
  unfold etaU at hconst
  rwa [div_eq_one_iff_eq (etaU_denom_ne_zero hw)] at hconst

/-! #### `η²⁴` as a function on `ℍ`, its slash-invariance, holomorphy, nonvanishing -/

/-- `η²⁴` on the upper half-plane. -/
noncomputable def η24 : ℍ → ℂ := fun z => ModularForm.eta (z : ℂ) ^ 24

lemma η24_ne_zero (z : ℍ) : η24 z ≠ 0 := pow_ne_zero _ (eta_ne_zero z.2)

lemma η24_slash_S : η24 ∣[(12 : ℤ)] S = η24 := by
  funext z
  rw [SL_slash_apply, denom_S]
  have hSz : ((S • z : ℍ) : ℂ) = -(z : ℂ)⁻¹ := by
    rw [modular_S_smul]
    exact inv_neg
  simp only [η24]
  rw [hSz, eta_S_pow z.2, _root_.zpow_neg, zpow_ofNat]
  have hz : (z : ℂ) ^ 12 ≠ 0 := pow_ne_zero _ z.ne_zero
  rw [mul_comm, ← mul_assoc, inv_mul_cancel₀ hz, one_mul]

lemma η24_slash_T : η24 ∣[(12 : ℤ)] T = η24 := by
  funext z
  rw [SL_slash_apply]
  have hTz : ((T • z : ℍ) : ℂ) = (z : ℂ) + 1 := by
    rw [modular_T_smul, coe_vadd]
    push_cast
    ring
  have hden : denom (T : SL(2, ℤ)) z = 1 := by
    simp [ModularGroup.T, denom_apply]
  simp only [η24]
  rw [hTz, hden, _root_.one_zpow, mul_one]
  exact eta_add_one_pow z

/-- **`η²⁴` is slash-invariant of weight 12 under all of `SL(2, ℤ)`.** -/
theorem η24_slash (γ : SL(2, ℤ)) : η24 ∣[(12 : ℤ)] γ = η24 :=
  slash_eq_of_S_T η24_slash_S η24_slash_T γ

lemma η24_smul_eq (γ : SL(2, ℤ)) (z : ℍ) : η24 (γ • z) = denom γ z ^ (12 : ℤ) * η24 z := by
  have h := congrFun (η24_slash γ) z
  rw [SL_slash_apply, _root_.zpow_neg] at h
  have hd : denom γ z ^ (12 : ℤ) ≠ 0 := zpow_ne_zero _ (denom_ne_zero γ z)
  rw [← h, mul_comm (denom γ z ^ (12 : ℤ)), mul_assoc, inv_mul_cancel₀ hd, mul_one]

lemma mdifferentiable_η24 : MDifferentiable 𝓘(ℂ) 𝓘(ℂ) η24 := by
  rw [UpperHalfPlane.mdifferentiable_iff]
  intro w hw
  have hw' : 0 < w.im := hw
  refine (DifferentiableAt.congr_of_eventuallyEq
    (f := fun v : ℂ => ModularForm.eta v ^ 24) ?_ ?_).differentiableWithinAt
  · exact (differentiableAt_eta_of_mem_upperHalfPlaneSet hw).pow 24
  · filter_upwards [isOpen_upperHalfPlaneSet.mem_nhds hw] with v hv
    simp only [Function.comp_apply, η24, ofComplex_apply_of_im_pos hv]
    try rfl

/-! #### Bounds for the `η`-product near the cusp -/

/-- `‖log(1 − x)‖ ≤ (3/2)‖x‖` for `‖x‖ ≤ 1/2`. -/
lemma norm_log_one_sub_le {x : ℂ} (hx : ‖x‖ ≤ 1 / 2) : ‖Complex.log (1 - x)‖ ≤ 3 / 2 * ‖x‖ := by
  have := Complex.norm_log_one_add_half_le_self (z := -x) (by rwa [norm_neg])
  rwa [norm_neg, ← sub_eq_add_neg] at this

lemma exp_half_le_two : Real.exp (1 / 2) ≤ 2 := by
  have h : Real.exp (1 / 2) ^ 2 = Real.exp 1 := by
    rw [← Real.exp_nat_mul]; norm_num
  nlinarith [Real.exp_pos (1 / 2), Real.exp_one_lt_d9, h]

/-- For `‖q‖ ≤ 1/8` (`q = 𝕢 1 z`), `1/2 ≤ ‖∏' (1 − q^(n+1))‖ ≤ 2`. -/
lemma etaProd_bounds {z : ℂ} (hz : z ∈ ℍₒ) (hq : ‖𝕢 1 z‖ ≤ 1 / 8) :
    1 / 2 ≤ ‖∏' n, (1 - eta_q n z)‖ ∧ ‖∏' n, (1 - eta_q n z)‖ ≤ 2 := by
  set q := 𝕢 1 z with hqdef
  have hq1 : ‖q‖ < 1 := by simpa using norm_qParam_lt_one 1 (⟨z, hz⟩ : ℍ)
  have hq0 : 0 ≤ ‖q‖ := norm_nonneg _
  have hsum : Summable fun n : ℕ => -eta_q n z := Summable.of_norm (summable_eta_q ⟨z, hz⟩)
  have hne : ∀ n, 1 + -eta_q n z ≠ 0 := fun n => by
    simpa [sub_eq_add_neg] using one_sub_eta_q_ne_zero n hz
  have hlog : Summable fun n : ℕ => Complex.log (1 + -eta_q n z) :=
    Complex.summable_log_one_add_of_summable hsum
  have hprod : cexp (∑' n, Complex.log (1 + -eta_q n z)) = ∏' n, (1 + -eta_q n z) :=
    Complex.cexp_tsum_eq_tprod hne hlog
  simp only [← sub_eq_add_neg] at hprod
  have hterm : ∀ n, ‖Complex.log (1 - eta_q n z)‖ ≤ 3 / 2 * ‖q‖ ^ (n + 1) := by
    intro n
    have hn : ‖eta_q n z‖ = ‖q‖ ^ (n + 1) := by simp [eta_q, hqdef, norm_pow]
    have hle : ‖eta_q n z‖ ≤ 1 / 2 := by
      rw [hn]
      calc ‖q‖ ^ (n + 1) ≤ ‖q‖ := pow_le_of_le_one hq0 hq1.le (Nat.succ_ne_zero n)
        _ ≤ 1 / 2 := by linarith
    rw [← hn]
    exact norm_log_one_sub_le hle
  have hgeo : Summable fun n : ℕ => 3 / 2 * ‖q‖ ^ (n + 1) :=
    ((summable_geometric_of_lt_one hq0 hq1).comp_injective (add_left_injective 1)).mul_left _
  have hnormsum : Summable fun n => ‖Complex.log (1 - eta_q n z)‖ :=
    Summable.of_nonneg_of_le (fun n => norm_nonneg _) hterm hgeo
  have hS : ‖∑' n, Complex.log (1 - eta_q n z)‖ ≤ 1 / 2 := by
    calc ‖∑' n, Complex.log (1 - eta_q n z)‖ ≤ ∑' n, ‖Complex.log (1 - eta_q n z)‖ :=
          norm_tsum_le_tsum_norm hnormsum
      _ ≤ ∑' n, 3 / 2 * ‖q‖ ^ (n + 1) := hnormsum.tsum_le_tsum hterm hgeo
      _ = 3 / 2 * (‖q‖ * (1 - ‖q‖)⁻¹) := by
          rw [tsum_mul_left]
          congr 1
          rw [← tsum_geometric_of_lt_one hq0 hq1, ← tsum_mul_left]
          exact tsum_congr fun n => by rw [pow_succ']
      _ ≤ 1 / 2 := by
          have h1 : (7 : ℝ) / 8 ≤ 1 - ‖q‖ := by linarith
          have h2 : (1 - ‖q‖)⁻¹ ≤ 8 / 7 := by
            rw [inv_le_comm₀ (by linarith) (by norm_num)]
            linarith
          have h3 : ‖q‖ * (1 - ‖q‖)⁻¹ ≤ 1 / 8 * (8 / 7) :=
            mul_le_mul hq h2 (by positivity) (by norm_num)
          linarith
  set L := ∑' n, Complex.log (1 - eta_q n z) with hL
  have hre : |L.re| ≤ 1 / 2 := (Complex.abs_re_le_norm L).trans hS
  have hnormP : ‖∏' n, (1 - eta_q n z)‖ = Real.exp L.re := by
    rw [← hprod, Complex.norm_exp]
  rw [hnormP, abs_le] at *
  constructor
  · calc (1 : ℝ) / 2 ≤ Real.exp (-(1 / 2)) := by
          rw [Real.exp_neg, one_div, inv_le_inv₀ (by norm_num) (Real.exp_pos _)]
          simpa [one_div] using exp_half_le_two
      _ ≤ Real.exp L.re := Real.exp_le_exp.mpr (by linarith [hre.1])
  · calc Real.exp L.re ≤ Real.exp (1 / 2) := Real.exp_le_exp.mpr hre.2
      _ ≤ 2 := exp_half_le_two

lemma exp_neg_six_le : Real.exp (-6) ≤ 1 / 8 := by
  have h := Real.pow_div_factorial_le_exp 6 (by norm_num) 3
  norm_num at h
  rw [Real.exp_neg, inv_le_comm₀ (Real.exp_pos _) (by norm_num)]
  linarith

/-- The lower bound `‖η²⁴(z)‖ ≥ e^{−2π Im z} (1/2)²⁴` for `Im z ≥ 1`. -/
lemma norm_η24_ge {z : ℍ} (hz : 1 ≤ z.im) :
    Real.exp (-2 * π * z.im) * (1 / 2) ^ 24 ≤ ‖η24 z‖ := by
  have hq : ‖𝕢 1 (z : ℂ)‖ ≤ 1 / 8 := by
    rw [Function.Periodic.norm_qParam, div_one, UpperHalfPlane.coe_im]
    have h1 : Real.exp (-2 * π * z.im) ≤ Real.exp (-6) :=
      Real.exp_le_exp.mpr (by nlinarith [Real.pi_gt_three, hz])
    linarith [exp_neg_six_le]
  obtain ⟨hlo, _⟩ := etaProd_bounds z.2 hq
  have hnorm : ‖η24 z‖ = Real.exp (-2 * π * z.im) * ‖∏' n, (1 - eta_q n (z : ℂ))‖ ^ 24 := by
    rw [η24, norm_pow, ModularForm.eta, norm_mul, Function.Periodic.norm_qParam, mul_pow, ← Real.exp_nat_mul,
      UpperHalfPlane.coe_im]
    congr 2
    push_cast
    ring
  rw [hnorm]
  exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by norm_num) hlo 24) (Real.exp_pos _).le

/-! #### The weight-0 quotient `g / η²⁴` and its constancy -/

variable {F : Type*} [FunLike F ℍ ℂ]

lemma quot_slash [CuspFormClass F (Γ(1) : Subgroup (GL (Fin 2) ℝ)) 12] (g : F) (γ : SL(2, ℤ)) :
    (fun z => g z / η24 z) ∣[(0 : ℤ)] γ = fun z => g z / η24 z := by
  funext z
  rw [SL_slash_apply, neg_zero, zpow_zero, mul_one,
    SlashInvariantForm.slash_action_eqn_SL'' g (mem_Gamma_one γ) z, η24_smul_eq]
  have hd : denom γ z ^ (12 : ℤ) ≠ 0 := zpow_ne_zero _ (denom_ne_zero γ z)
  rw [mul_div_mul_left _ _ hd]

lemma isBoundedAtImInfty_quot [CuspFormClass F (Γ(1) : Subgroup (GL (Fin 2) ℝ)) 12] (g : F) :
    IsBoundedAtImInfty fun z => g z / η24 z := by
  have hg := CuspFormClass.exp_decay_atImInfty (f := g) one_pos
    RankinSelbergDelta.CuspForm.one_mem_strictPeriods_levelOne
  rw [Asymptotics.isBigO_iff] at hg
  obtain ⟨C, hC⟩ := hg
  rw [Filter.eventually_iff, atImInfty_mem] at hC
  obtain ⟨A, hA⟩ := hC
  rw [isBoundedAtImInfty_iff]
  refine ⟨|C| * 2 ^ 24, max A 1, fun z hz => ?_⟩
  have hzA : A ≤ z.im := le_trans (le_max_left A 1) hz
  have hz1 : 1 ≤ z.im := le_trans (le_max_right A 1) hz
  have hgz := hA z hzA
  simp only [Set.mem_setOf_eq, div_one, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)] at hgz
  have hη := norm_η24_ge hz1
  have hηpos : 0 < ‖η24 z‖ := norm_pos_iff.mpr (η24_ne_zero z)
  have hE : 0 < Real.exp (-2 * π * z.im) := Real.exp_pos _
  rw [norm_div, div_le_iff₀ hηpos]
  calc ‖g z‖ ≤ C * Real.exp (-2 * π * z.im) := hgz
    _ ≤ |C| * Real.exp (-2 * π * z.im) := mul_le_mul_of_nonneg_right (le_abs_self C) hE.le
    _ = |C| * 2 ^ 24 * (Real.exp (-2 * π * z.im) * (1 / 2) ^ 24) := by ring
    _ ≤ |C| * 2 ^ 24 * ‖η24 z‖ := mul_le_mul_of_nonneg_left hη (by positivity)

/-- `g / η²⁴` as a weight-0 level-one modular form. -/
noncomputable def quotEta [CuspFormClass F (Γ(1) : Subgroup (GL (Fin 2) ℝ)) 12] (g : F) :
    ModularForm (Γ(1) : Subgroup (GL (Fin 2) ℝ)) 0 where
  toFun := fun z => g z / η24 z
  slash_action_eq' := by
    intro γ hγ
    obtain ⟨γ', _, rfl⟩ := Subgroup.mem_map.mp hγ
    exact quot_slash g γ'
  holo' := by
    rw [UpperHalfPlane.mdifferentiable_iff]
    exact (UpperHalfPlane.mdifferentiable_iff.mp (CuspFormClass.holo g)).div
      (UpperHalfPlane.mdifferentiable_iff.mp mdifferentiable_η24) (fun w _ => η24_ne_zero _)
  bdd_at_cusps' := by
    intro c hc
    rw [Subgroup.IsArithmetic.isCusp_iff_isCusp_SL2Z] at hc
    rw [OnePoint.isBoundedAt_iff_forall_SL2Z hc]
    intro γ _
    rw [quot_slash g γ]
    exact isBoundedAtImInfty_quot g

/-- **Every level-one weight-12 cusp form is a constant multiple of `η²⁴`.** -/
theorem exists_eq_mul_η24 [CuspFormClass F (Γ(1) : Subgroup (GL (Fin 2) ℝ)) 12] (g : F) :
    ∃ c : ℂ, ∀ z, g z = c * η24 z := by
  obtain ⟨c, hc⟩ := ModularFormClass.levelOne_weight_zero_const (quotEta g)
  refine ⟨c, fun z => ?_⟩
  have h : g z / η24 z = c := congrFun hc z
  rwa [div_eq_iff (η24_ne_zero z)] at h

/-- `Δ = c · η²⁴` with `c ≠ 0`. -/
theorem Δ_eq_mul_η24 : ∃ c : ℂ, c ≠ 0 ∧ ∀ z, RankinSelbergDelta.CuspForm.Δ z = c * η24 z := by
  obtain ⟨c, hc⟩ := exists_eq_mul_η24 RankinSelbergDelta.CuspForm.Δ
  refine ⟨c, ?_, hc⟩
  rintro rfl
  apply RankinSelbergDelta.CuspForm.Δ_ne_zero
  funext z
  simp [hc z]

/-- **`Δ` does not vanish on the upper half-plane.** -/
theorem Δ_ne_zero_on_H (z : ℍ) : RankinSelbergDelta.CuspForm.Δ z ≠ 0 := by
  obtain ⟨c, hc0, hc⟩ := Δ_eq_mul_η24
  rw [hc z]
  exact mul_ne_zero hc0 (η24_ne_zero z)

/-- **`Δ` is a Hecke eigenform**: `T_p Δ = c_p • Δ` for every prime `p`. -/
theorem heckeT_Delta_eq_smul (p : ℕ) (hpp : p.Prime) (hp : (p : ℝ) ≠ 0) :
    ∃ c : ℂ, heckeT p 12 hp ⇑RankinSelbergDelta.CuspForm.Δ = c • ⇑RankinSelbergDelta.CuspForm.Δ := by
  obtain ⟨c, hc0, hc⟩ := Δ_eq_mul_η24
  obtain ⟨c', hc'⟩ := exists_eq_mul_η24 (heckeTCuspForm p hpp 12 hp RankinSelbergDelta.CuspForm.Δ)
  refine ⟨c' / c, ?_⟩
  funext z
  have h1 : heckeT p 12 hp (⇑RankinSelbergDelta.CuspForm.Δ) z = c' * η24 z := by
    rw [← coe_heckeTCuspForm]
    exact hc' z
  rw [h1, Pi.smul_apply, smul_eq_mul, hc z]
  field_simp

/-- **The `T_p` coefficient read-off**: the `q`-expansion coefficients of the cusp form
`heckeTCuspForm p k f` are exactly `b(n) = a(pn) + [p∣n] p^{k-1} a(n/p)`, from the HasSum form
`hasSum_heckeT_qExpansion` via `qExpansion_coeff_unique` (uniqueness of `q`-expansion coefficients). -/
lemma heckeTCuspForm_coeff (p : ℕ) (hpp : p.Prime) (k : ℤ) (hp0 : 0 < p) (hp : (p : ℝ) ≠ 0)
    [CuspFormClass F (Γ(1) : Subgroup (GL (Fin 2) ℝ)) k] (f : F) (n : ℕ) :
    (ModularFormClass.qExpansion 1 (heckeTCuspForm p hpp k hp f)).coeff n
      = (ModularFormClass.qExpansion 1 f).coeff (p * n)
        + (if p ∣ n then ((p : ℝ) : ℂ) ^ (k - 1)
            * (ModularFormClass.qExpansion 1 f).coeff (n / p) else 0) := by
  have key : ∀ τ : ℍ, HasSum
      (fun m => ((ModularFormClass.qExpansion 1 f).coeff (p * m)
          + (if p ∣ m then ((p : ℝ) : ℂ) ^ (k - 1)
              * (ModularFormClass.qExpansion 1 f).coeff (m / p) else 0))
        • Function.Periodic.qParam 1 (τ : ℂ) ^ m)
      (⇑(heckeTCuspForm p hpp k hp f) τ) := by
    intro τ
    rw [coe_heckeTCuspForm p hpp k hp f]
    exact hasSum_heckeT_qExpansion (F := F) (k := k) p hp0 hp f τ
  exact (qExpansion_coeff_unique (f := heckeTCuspForm p hpp k hp f) one_pos
    RankinSelbergDelta.CuspForm.one_mem_strictPeriods_levelOne key n).symm

/-! ### The Hecke recursion for the normalized `Δ` coefficients. -/

/-- `Δ` and `ΔModular` have the same `q`-expansion coefficients (same underlying function). -/
lemma coeff_Δ_eq_coeff_ΔModular (n : ℕ) :
    (ModularFormClass.qExpansion 1 RankinSelbergDelta.CuspForm.Δ).coeff n
      = (ModularFormClass.qExpansion 1 RankinSelbergDelta.CuspForm.ΔModular).coeff n := by
  refine (qExpansion_coeff_unique (f := RankinSelbergDelta.CuspForm.Δ)
    (c := fun m => (ModularFormClass.qExpansion 1 RankinSelbergDelta.CuspForm.ΔModular).coeff m)
    one_pos RankinSelbergDelta.CuspForm.one_mem_strictPeriods_levelOne (fun τ => ?_) n).symm
  rw [RankinSelbergDelta.CuspForm.coe_Δ]
  exact ModularFormClass.hasSum_qExpansion (k := 12) RankinSelbergDelta.CuspForm.ΔModular one_pos
    RankinSelbergDelta.CuspForm.one_mem_strictPeriods_levelOne τ

/-- The normalized coefficient `aΔ n = (1/1728) · (q-exp of Δ).coeff n`. -/
lemma aΔ_eq_coeff_Δ (n : ℕ) :
    aΔ n = (1 / 1728 : ℂ) * (ModularFormClass.qExpansion 1 RankinSelbergDelta.CuspForm.Δ).coeff n := by
  rw [aΔ, coeff_ΔnormM, coeff_Δ_eq_coeff_ΔModular]

/-- **The Hecke eigen-relation for the normalized `Δ` coefficients**: there is an eigenvalue `c`
with `aΔ(pn) + [p∣n] p^{11} aΔ(n/p) = c · aΔ(n)` for all `n`, from `T_p Δ = c Δ` + the coefficient
read-off. -/
lemma aΔ_hecke_relation (p : ℕ) (hpp : p.Prime) (hp0 : 0 < p) (hp : (p : ℝ) ≠ 0) :
    ∃ c : ℂ, ∀ n : ℕ, aΔ (p * n)
        + (if p ∣ n then ((p : ℝ) : ℂ) ^ ((12 : ℤ) - 1) * aΔ (n / p) else 0)
      = c * aΔ n := by
  obtain ⟨c, hc⟩ := heckeT_Delta_eq_smul p hpp hp
  refine ⟨c, fun n => ?_⟩
  -- eigenvalue read-off: coeff(heckeTCuspForm Δ) n = c · coeff Δ n
  have hev : (ModularFormClass.qExpansion 1 (heckeTCuspForm p hpp 12 hp RankinSelbergDelta.CuspForm.Δ)).coeff n
      = c * (ModularFormClass.qExpansion 1 RankinSelbergDelta.CuspForm.Δ).coeff n := by
    refine (qExpansion_coeff_unique (f := heckeTCuspForm p hpp 12 hp RankinSelbergDelta.CuspForm.Δ)
      (c := fun m => c * (ModularFormClass.qExpansion 1 RankinSelbergDelta.CuspForm.Δ).coeff m)
      one_pos RankinSelbergDelta.CuspForm.one_mem_strictPeriods_levelOne (fun τ => ?_) n).symm
    have hΔ := (ModularFormClass.hasSum_qExpansion (k := 12) RankinSelbergDelta.CuspForm.Δ one_pos
      RankinSelbergDelta.CuspForm.one_mem_strictPeriods_levelOne τ).mul_left c
    rw [coe_heckeTCuspForm, hc, Pi.smul_apply, smul_eq_mul]
    convert hΔ using 2 with m
    rw [smul_eq_mul, smul_eq_mul, mul_assoc]
  -- combine with the coefficient formula (heckeTCuspForm_coeff), then normalize by 1/1728
  have hb := heckeTCuspForm_coeff p hpp 12 hp0 hp RankinSelbergDelta.CuspForm.Δ n
  rw [hev] at hb
  -- hb : c * coeff Δ n = coeff Δ (p*n) + if p∣n then p^(12-1) * coeff Δ (n/p) else 0
  simp only [aΔ_eq_coeff_Δ]
  split_ifs at hb ⊢ with hd <;> linear_combination (-(1 / 1728 : ℂ)) * hb

/-- **The Hecke-eigenform recursion for the normalized `Δ` coefficients** (the `recursion` field of
`IsHeckeEigenCoeffs aΔ 12`): `aΔ(p^{r+2}) = aΔ(p)·aΔ(p^{r+1}) − p^{11}·aΔ(p^r)`. -/
lemma recursion_aΔ (p r : ℕ) (hpp : p.Prime) :
    aΔ (p ^ (r + 2)) = aΔ p * aΔ (p ^ (r + 1)) - ((p : ℂ)) ^ ((12 : ℤ) - 1) * aΔ (p ^ r) := by
  have hp0 : 0 < p := hpp.pos
  have hp : (p : ℝ) ≠ 0 := by exact_mod_cast hp0.ne'
  obtain ⟨c, hrel⟩ := aΔ_hecke_relation p hpp hp0 hp
  -- c = aΔ p at n = 1
  have hc1 : aΔ p = c := by
    have h1 := hrel 1
    rwa [mul_one, if_neg (fun h => hpp.one_lt.ne' (Nat.dvd_one.mp h)), add_zero, aΔ_one,
      mul_one] at h1
  -- at n = p^(r+1): p ∣ p^(r+1), p^(r+1)/p = p^r, p·p^(r+1) = p^(r+2)
  have hdiv : p ^ (r + 1) / p = p ^ r := by rw [pow_succ]; exact Nat.mul_div_cancel _ hp0
  have hmul : p * p ^ (r + 1) = p ^ (r + 2) := by rw [← pow_succ']
  have hn := hrel (p ^ (r + 1))
  rw [if_pos (dvd_pow_self p (Nat.succ_ne_zero r)), hdiv, hmul, ← hc1] at hn
  -- hn : aΔ(p^(r+2)) + p^(12-1) * aΔ(p^r) = aΔ(p) * aΔ(p^(r+1))
  have hcast : ((p : ℝ) : ℂ) ^ ((12 : ℤ) - 1) = ((p : ℂ)) ^ ((12 : ℤ) - 1) := by
    rw [Complex.ofReal_natCast]
  rw [hcast] at hn
  linear_combination hn

/-- **The Hecke-eigenform relations for the normalized `Δ` coefficients** -- all four fields proved.
From the single-prime eigen-relation `aΔ_hecke_relation` (itself from the `T_p` eigenform
`heckeT_Delta_eq_smul` + the coefficient read-off), `isHeckeEigenCoeffs_of_relation` derives both the
coprime multiplicativity (strong induction, no composite Hecke operator needed) and the prime-power
recursion. This completes `IsHeckeEigenCoeffs aΔ 12`. -/
theorem isHeckeEigenCoeffs_aΔ' : RankinSelbergDelta.RankinSelberg.IsHeckeEigenCoeffs aΔ 12 := by
  refine isHeckeEigenCoeffs_of_relation aΔ 12 aΔ_zero aΔ_one (fun p hpp => ?_)
  obtain ⟨c, hc⟩ := aΔ_hecke_relation p hpp hpp.pos (by exact_mod_cast hpp.pos.ne')
  refine ⟨c, fun n => ?_⟩
  have h := hc n
  rwa [Complex.ofReal_natCast] at h

end RankinSelbergDelta.Hecke
